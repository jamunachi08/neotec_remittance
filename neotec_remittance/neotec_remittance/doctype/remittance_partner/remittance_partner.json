{
 "doctype": "DocType",
 "name": "Remittance Partner",
 "module": "Neotec Remittance",
 "custom": 0,
 "engine": "InnoDB",
 "autoname": "field:partner_name",
 "naming_rule": "By fieldname",
 "istable": 0,
 "issingle": 0,
 "is_submittable": 0,
 "track_changes": 1,
 "sort_field": "creation",
 "sort_order": "DESC",
 "in_create": 0,
 "fields": [
  {
   "fieldname": "partner_name",
   "fieldtype": "Data",
   "label": "Partner Name",
   "reqd": 1,
   "unique": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "adapter",
   "fieldtype": "Select",
   "label": "Adapter",
   "options": "Sandbox\nGateway\nCustom",
   "default": "Sandbox",
   "in_list_view": 1
  },
  {
   "fieldname": "adapter_path",
   "fieldtype": "Data",
   "label": "Custom Adapter Class",
   "depends_on": "eval:doc.adapter=='Custom'"
  },
  {
   "fieldname": "environment",
   "fieldtype": "Select",
   "label": "Environment",
   "options": "Sandbox\nProduction",
   "default": "Sandbox"
  },
  {
   "fieldname": "enabled",
   "fieldtype": "Check",
   "label": "Enabled",
   "default": "0"
  },
  {
   "fieldname": "cb1",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "gateway_url",
   "fieldtype": "Data",
   "label": "Bank Gateway URL",
   "depends_on": "eval:doc.adapter=='Gateway'"
  },
  {
   "fieldname": "gateway_secret",
   "fieldtype": "Password",
   "label": "Gateway Secret",
   "depends_on": "eval:doc.adapter=='Gateway'"
  },
  {
   "fieldname": "callback_secret",
   "fieldtype": "Password",
   "label": "Callback Verification Secret"
  },
  {
   "fieldname": "callback_replay_window_seconds",
   "fieldtype": "Int",
   "label": "Callback Replay Window Seconds",
   "default": "300"
  },
  {
   "fieldname": "sb_cap",
   "fieldtype": "Section Break",
   "label": "Capability Profile"
  },
  {
   "fieldname": "cap_idempotent_create",
   "fieldtype": "Check",
   "label": "Bank Guarantees Duplicate Prevention On Retry",
   "default": "0"
  },
  {
   "fieldname": "cap_status_inquiry",
   "fieldtype": "Check",
   "label": "Supports Status Inquiry",
   "default": "1"
  },
  {
   "fieldname": "cap_recall",
   "fieldtype": "Check",
   "label": "Supports Cancel / Recall",
   "default": "0"
  },
  {
   "fieldname": "cb2",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "cap_webhook",
   "fieldtype": "Check",
   "label": "Supports Signed Callbacks",
   "default": "1"
  },
  {
   "fieldname": "cap_balance",
   "fieldtype": "Check",
   "label": "Supports Balance Inquiry",
   "default": "0"
  },
  {
   "fieldname": "cap_not_found_is_final",
   "fieldtype": "Check",
   "label": "Status 'Not Found' Is Certified Non-execution",
   "default": "0"
  },
  {
   "fieldname": "capability_notes",
   "fieldtype": "Small Text",
   "label": "Capability Notes"
  }
 ],
 "field_order": [
  "partner_name",
  "adapter",
  "adapter_path",
  "environment",
  "enabled",
  "cb1",
  "gateway_url",
  "gateway_secret",
  "callback_secret",
  "callback_replay_window_seconds",
